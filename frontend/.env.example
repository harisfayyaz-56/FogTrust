# Copy to .env for local development. Vite loads this automatically.
#
# Real Django broker (Phase 3). Set to true to start in offline demo mode.
VITE_USE_MOCK=false
#
# Leave empty to send /api requests through the Vite dev proxy
# (server.proxy in vite.config.ts). Set an absolute URL only when the
# dashboard is served separately from the broker, and configure Django
# CSRF_TRUSTED_ORIGINS for that origin.
VITE_API_BASE_URL=
