# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value

# Development only. Must be False for the final demo build.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# React dev server (Member 4). Needed so CSRF accepts requests from it.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sessions: idle timeout in seconds (30 minutes)
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Set to True only when served over HTTPS
COOKIE_SECURE=False

# Largest accepted request body in bytes (256 KB)
MAX_REQUEST_BODY_BYTES=262144

# Path to the SQLite database file (relative to backend/ or absolute)
SQLITE_PATH=db.sqlite3

# Absolute session lifetime in seconds, however active the user is (8 hours)
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Login rate limits (per client IP, and per username)
LOGIN_RATE_LIMIT=5/min
LOGIN_USERNAME_RATE_LIMIT=20/hour

# --- Week 3 (Member 1) ---
# Result-encryption key (FR-5). Create it with: python manage.py generate_server_key
# then paste the line it prints. The file is git-ignored and readable only by you.
FOGTRUST_RESULT_KEY_FILE=keys/server_x25519.key

# Fallback starting trust score (0 to 100). A new node normally starts at the policy's
# `initial_score` (editable by an administrator); this is used only if the policy has none.
INITIAL_TRUST_SCORE=80

# Enrollment attempts allowed per client IP
ENROLL_RATE_LIMIT=10/min

# How many reverse proxies sit in front of the server. Keep 0 on a laptop: any value above 0
# makes the server trust the X-Forwarded-For header, which any client can forge.
TRUSTED_PROXY_COUNT=0

# Signed requests from nodes: allowed per node per minute, and failed authentications
# per client IP per minute before the audit log switches to a one-line summary
NODE_REQUEST_RATE_LIMIT=120/min
NODE_AUTH_FAILED_RATE_LIMIT=30/min
